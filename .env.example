# Public Vite env vars (safe for the browser — never put secrets here)
# Copy to `.env` or `.env.local` and fill in as needed.

# Yandex Metrica counter ID. Loaded after cookie consent accept.
VITE_YANDEX_METRICA_ID=

# Absolute site origin for canonical / Open Graph URLs (no trailing slash).
# Example: https://kotdela.ru
VITE_SITE_URL=

# Local AI Growth Engine backend (public URL only; never put credentials here).
VITE_AI_API_URL=http://localhost:8000

# Base path for GitHub Pages (default in build scripts: /web-studio-landing/)
# VITE_BASE=/
